        function setPasienAktif(profile) {
            currentProfile = profile;
            updateProfileUI(profile);
            renderPatientList();
            renderHistoryTable(); 
            
            if (typeof chatPollingInterval !== 'undefined' && chatPollingInterval !== null) {
                clearInterval(chatPollingInterval);
            }
            fetchChat();
            chatPollingInterval = setInterval(fetchChat, 2000); // Sinkronisasi setiap 2 detik

            renderChat(); // Panggil renderChat di sini agar chat berganti sesuai pasien
        }

        function pilihPasien(index) {
            const selectedProfile = registeredPatients[index];
            setPasienAktif(selectedProfile);
            showToast(`Profil ${selectedProfile.name} diaktifkan`, 'success');
            
            switchView('dashboard');
            updateDashboardMode(); // Pastikan layout chat disesuaikan saat masuk
            
            if (typeof pollingInterval !== 'undefined' && pollingInterval) { 
                clearInterval(pollingInterval); 
                pollingInterval = null; 
            }
            setOnlineStatus(false);
            prevLatestDataStr = null; 
            updateCardsUI({ bodyTemperature: 0, heartRate: 0, spo2: 0, roomTemperature: 0, humidity: 0, airQuality: 0 });
        }

        function updateProfileUI(profile) {
            if (!profile) {
                document.getElementById('header-name').innerText = 'Pilih Pasien';
