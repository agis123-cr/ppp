            const toast = document.createElement('div');
            const bgColor = type === 'error' ? 'bg-red-500' : (type === 'warning' ? 'bg-yellow-500' : 'bg-emerald-500');
            const icon = type === 'error' ? 'warning-circle' : (type === 'warning' ? 'warning' : 'check-circle');
            
            toast.className = `toast-enter ${bgColor} text-white px-5 py-4 rounded-2xl shadow-xl flex items-center gap-3 text-sm font-bold pointer-events-auto`;
            toast.innerHTML = `<i class="ph-fill ph-${icon} text-2xl"></i> <span>${message}</span>`;
            
