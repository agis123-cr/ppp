
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medisyne Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc; /* slate-50 */
        }
        /* Custom scrollbar */
        .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* Animasi */
        @keyframes slideIn {
            from { transform: translateY(-100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; transform: translateX(0); }
            to { opacity: 0; transform: translateX(100%); }
        }
        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); color: #0ea5e9; }
            100% { transform: scale(1); }
        }
        @keyframes pulseAlert {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
            50% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        }
        .toast-enter { animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .toast-exit { animation: fadeOut 0.3s ease-in forwards; }
        .value-update { animation: pop 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        
        /* Transisi Hover Kartu Pasien */
        .patient-card-hover { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .patient-card-hover:hover { transform: translateX(8px); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.1); }
    </style>
</head>
<body class="text-slate-800 antialiased h-[100dvh] overflow-hidden relative">

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>

    <!-- ========================================== -->
    <!-- VIEW: ROLE SELECTION (PAGE 1) -->
    <!-- ========================================== -->
    <div id="view-role-selection" class="h-full flex flex-col items-center p-4 md:p-8 bg-slate-900/5 relative overflow-y-auto">
        <div class="m-auto shrink-0 bg-white rounded-2xl md:rounded-3xl shadow-xl w-full max-w-4xl overflow-hidden min-h-0 md:min-h-[500px] flex flex-col relative">
            
            <!-- Header/Branding -->
            <div class="bg-gradient-to-r from-[#0ea5e9] to-[#3b82f6] p-10 flex flex-col justify-center items-center relative overflow-hidden shrink-0">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.2)_1px,transparent_1px)]" style="background-size: 24px 24px;"></div>
                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center mb-4 shadow-xl rotate-3">
                        <i class="ph-fill ph-heartbeat text-5xl text-[#0ea5e9]"></i>
                    </div>
                    <h1 class="text-3xl font-black text-white tracking-tight text-center">Selamat Datang di MEDISYNE</h1>
                    <p class="text-sm text-sky-100 font-medium text-center mt-2 max-w-md">Sistem Pemantauan Telemetri Kesehatan Real-time Terintegrasi.</p>
                </div>
            </div>

            <!-- Role Selection Options -->
            <div class="p-8 md:p-12 flex-1 flex flex-col justify-center bg-slate-50">
                <h2 class="text-center text-slate-500 font-bold tracking-widest text-xs mb-8 uppercase">Pilih Peran Anda untuk Memulai</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto w-full">
                    
                    <!-- Card Pasien -->
                    <button onclick="switchView('landing')" class="group flex flex-col items-center text-left bg-white p-8 rounded-3xl border-2 border-slate-200 hover:border-[#0ea5e9] hover:shadow-xl hover:shadow-sky-500/10 transition-all duration-300 transform hover:-translate-y-1">
                        <div class="w-20 h-20 rounded-full bg-blue-50 text-[#0ea5e9] flex items-center justify-center mb-6 group-hover:bg-[#0ea5e9] group-hover:text-white transition-colors duration-300">
                            <i class="ph-fill ph-user-circle text-5xl"></i>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 mb-2 group-hover:text-[#0ea5e9] transition-colors">Portal Pasien</h3>
                        <p class="text-sm text-slate-500 text-center leading-relaxed">Masuk untuk melihat data telemetri Anda sendiri atau mendaftarkan sesi pemantauan baru.</p>
                        <div class="mt-6 flex items-center gap-2 text-[#0ea5e9] font-bold text-sm opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0">
                            Masuk <i class="ph-bold ph-arrow-right"></i>
                        </div>
                    </button>

                    <!-- Card Dokter -->
                    <button onclick="switchView('doctor-portal')" class="group flex flex-col items-center text-left bg-white p-8 rounded-3xl border-2 border-slate-200 hover:border-emerald-500 hover:shadow-xl hover:shadow-emerald-500/10 transition-all duration-300 transform hover:-translate-y-1">
                        <div class="w-20 h-20 rounded-full bg-emerald-50 text-emerald-500 flex items-center justify-center mb-6 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300">
                            <i class="ph-fill ph-stethoscope text-5xl"></i>
                        </div>
                        <h3 class="text-xl font-black text-slate-800 mb-2 group-hover:text-emerald-500 transition-colors">Portal Dokter</h3>
                        <p class="text-sm text-slate-500 text-center leading-relaxed">Akses dashboard medis untuk memantau data vital pasien secara komprehensif.</p>
                        <div class="mt-6 flex items-center gap-2 text-emerald-500 font-bold text-sm opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0">
                            Masuk <i class="ph-bold ph-arrow-right"></i>
                        </div>
                    </button>

                </div>
            </div>
            
            <!-- Footer text -->
            <div class="py-4 text-center text-[10px] font-bold text-slate-400 bg-slate-50 border-t border-slate-200 shrink-0">
                MEDISYNE SYSTEM V1.0 &copy; 2026
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW: DOCTOR PORTAL / LOGIN -->
    <!-- ========================================== -->
    <div id="view-doctor-portal" class="hidden h-full flex flex-col items-center p-4 md:p-8 bg-slate-900/5 relative overflow-y-auto">
        <div class="m-auto shrink-0 bg-white rounded-2xl md:rounded-3xl shadow-xl flex flex-col md:flex-row w-full max-w-5xl overflow-hidden min-h-0 md:min-h-[600px] relative">
            
            <!-- Back to Role Selection Button -->
            <button onclick="switchView('role-selection')" class="absolute top-4 left-4 md:top-8 md:left-8 z-20 text-white/80 hover:text-white bg-black/10 hover:bg-black/20 p-2 rounded-full transition-colors flex items-center gap-2 text-xs font-bold backdrop-blur-sm shadow-sm">
                <i class="ph-bold ph-arrow-left text-lg"></i> <span class="hidden md:inline">Ganti Peran</span>
            </button>

            <!-- Panel Kiri: Emerald dengan Motif Medis -->
            <div class="bg-emerald-500 p-8 flex flex-col justify-center items-center w-full md:w-2/5 relative overflow-hidden shrink-0 pt-16 md:pt-8">
                
                <!-- Motif Medis -->
                <div class="absolute inset-0 z-0 pointer-events-none">
                    <i class="ph-fill ph-cross absolute top-10 left-10 text-[80px] text-white opacity-40"></i>
                    <i class="ph-fill ph-shield-plus absolute bottom-20 right-10 text-[100px] text-white opacity-40 rotate-12"></i>
                    <i class="ph-fill ph-syringe absolute top-1/3 -right-10 text-[120px] text-white opacity-40 -rotate-45"></i>
                    <i class="ph-fill ph-file-text absolute bottom-10 left-1/4 text-[70px] text-white opacity-40 rotate-12"></i>
                    <i class="ph-fill ph-pulse absolute top-1/4 left-1/2 text-[50px] text-white opacity-40"></i>
                    <!-- Subtle Grid -->
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.2)_1px,transparent_1px)]" style="background-size: 24px 24px;"></div>
                </div>
                
                <!-- Branding Utama -->
                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center mb-6 shadow-2xl">
                        <i class="ph-fill ph-stethoscope text-6xl text-emerald-500"></i>
                    </div>
                    <h1 class="text-4xl font-black text-white tracking-tight text-center">MEDISYNE</h1>
                    <p class="text-xs text-emerald-100 font-bold tracking-widest text-center mt-2 uppercase">Portal Dokter & Tenaga Medis</p>
                    <p class="text-[11px] text-white/90 text-center mt-6 max-w-xs leading-relaxed">Masuk menggunakan kredensial medis Anda untuk memantau data vital pasien secara komprehensif.</p>
                </div>
            </div>
            
            <!-- Panel Kanan: Form Login -->
            <div class="p-6 md:p-10 w-full md:w-3/5 flex flex-col h-full bg-white justify-center">
                
                <!-- Form Login -->
                <div class="w-full max-w-md mx-auto">
                    <div class="flex items-center gap-2 text-emerald-500 font-bold mb-8 text-sm justify-center">
                        <i class="ph ph-lock-key text-xl"></i> OTENTIKASI TENAGA MEDIS
                    </div>

                    <div class="space-y-5">
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 ml-2 mb-1 block uppercase">Nama Dokter</label>
                            <div class="relative">
                                <i class="ph-fill ph-user absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                                <input id="input-doc-name" type="text" placeholder="Cth: dr. Budi Santoso" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-11 pr-4 py-3.5 text-sm outline-none focus:border-emerald-500 focus:bg-white transition-colors" />
                            </div>
                        </div>
                        
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 ml-2 mb-1 block uppercase">Kode STR (Surat Tanda Registrasi)</label>
                            <div class="relative">
                                <i class="ph-fill ph-identification-card absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                                <input id="input-doc-str" type="password" placeholder="Masukkan 16 digit STR..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-11 pr-4 py-3.5 text-sm outline-none focus:border-emerald-500 focus:bg-white transition-colors" />
                            </div>
                        </div>
                    </div>

                    <button onclick="loginDokter()" class="w-full bg-emerald-500 hover:bg-emerald-600 transition-colors text-white font-bold py-4 rounded-xl shadow-lg shadow-emerald-500/30 mt-8 text-sm flex items-center justify-center gap-2 active:scale-[0.98] transform duration-150">
                        MASUK DASHBOARD MEDIS <i class="ph-bold ph-sign-in"></i>
                    </button>
                    
                    <div class="mt-8 text-center">
                        <p class="text-xs text-slate-400 font-medium">Bukan tenaga medis? <button onclick="switchView('landing')" class="text-emerald-500 hover:text-emerald-600 font-bold ml-1 transition-colors">Masuk sebagai Pasien</button></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW: LANDING PAGE / REGISTRATION (PAGE 2) -->
    <!-- ========================================== -->
    <div id="view-landing" class="hidden h-full flex flex-col items-center p-4 md:p-8 bg-slate-900/5 relative overflow-y-auto">
        <div class="m-auto shrink-0 bg-white rounded-2xl md:rounded-3xl shadow-xl flex flex-col md:flex-row w-full max-w-5xl overflow-hidden min-h-0 md:min-h-[600px] relative">
            
            <!-- Back to Role Selection Button -->
            <button onclick="switchView('role-selection')" class="absolute top-4 left-4 md:top-8 md:left-8 z-20 text-white/80 hover:text-white bg-black/10 hover:bg-black/20 p-2 rounded-full transition-colors flex items-center gap-2 text-xs font-bold backdrop-blur-sm shadow-sm">
                <i class="ph-bold ph-arrow-left text-lg"></i> <span class="hidden md:inline">Ganti Peran</span>
            </button>

            <!-- Panel Kiri: Biru dengan Motif Kesehatan -->
            <div class="bg-[#0ea5e9] p-8 flex flex-col justify-center items-center w-full md:w-2/5 relative overflow-hidden shrink-0 pt-16 md:pt-8">
                
                <!-- Motif Kesehatan -->
                <div class="absolute inset-0 z-0 pointer-events-none">
                    <i class="ph-fill ph-heartbeat absolute top-10 left-10 text-[80px] text-white opacity-50"></i>
                    <i class="ph-fill ph-dna absolute bottom-20 right-10 text-[100px] text-white opacity-50 rotate-45"></i>
                    <i class="ph-fill ph-stethoscope absolute top-1/3 -right-10 text-[120px] text-white opacity-50 -rotate-12"></i>
                    <i class="ph-fill ph-pill absolute bottom-10 left-1/4 text-[70px] text-white opacity-50 rotate-12"></i>
                    <i class="ph-fill ph-first-aid absolute top-1/4 left-1/2 text-[50px] text-white opacity-50 -rotate-45"></i>
                    <!-- Subtle Grid -->
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.2)_1px,transparent_1px)]" style="background-size: 24px 24px;"></div>
                </div>
                
                <!-- Branding Utama -->
                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center mb-6 shadow-2xl">
                        <i class="ph-fill ph-robot text-6xl text-[#0ea5e9]"></i>
                    </div>
                    <h1 class="text-4xl font-black text-white tracking-tight text-center">MEDISYNE</h1>
                    <p class="text-xs text-sky-100 font-bold tracking-widest text-center mt-2 uppercase">Portal Pasien & Telemetri</p>
                    <p class="text-[11px] text-white/90 text-center mt-6 max-w-xs leading-relaxed">Daftarkan profil pasien atau pilih dari riwayat untuk memulai pemantauan sensor real-time.</p>
                </div>
            </div>
            
            <!-- Panel Kanan: Form & List -->
            <div class="p-6 md:p-10 w-full md:w-3/5 flex flex-col h-full bg-white">
                
                <!-- Form Registrasi -->
                <div class="mb-6 shrink-0">
                    <div class="flex items-center gap-2 text-[#0ea5e9] font-bold mb-4 text-sm">
                        <i class="ph ph-user-plus text-lg"></i> REGISTRASI PASIEN BARU
                    </div>
                    
                    <!-- Pilihan Avatar Cerdas -->
                    <div class="mb-4">
                        <label class="text-[10px] font-bold text-slate-400 ml-2 mb-2 block">PILIH AVATAR PASIEN</label>
                        <div class="grid grid-cols-6 gap-2" id="avatar-selection-grid">
                            <!-- Avatar akan digenerate via JS -->
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 ml-2 mb-1 block">NAMA PASIEN</label>
                            <input id="input-new-name" type="text" placeholder="Masukkan nama..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#0ea5e9] focus:bg-white transition-colors" />
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-400 ml-2 mb-1 block">UMUR PASIEN</label>
                            <input id="input-new-age" type="number" placeholder="Usia..." min="1" max="150" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#0ea5e9] focus:bg-white transition-colors" />
                        </div>
                    </div>
                    <button onclick="simpanPasienBaru()" class="w-full bg-[#0ea5e9] hover:bg-[#0284c7] transition-colors text-white font-bold py-3.5 rounded-xl shadow-lg shadow-sky-500/30 mt-5 text-sm flex items-center justify-center gap-2 active:scale-[0.98] transform duration-150">
                        DAFTAR & MASUK DASHBOARD <i class="ph-bold ph-arrow-right"></i>
                    </button>
                </div>

                <div class="border-t border-slate-100 my-2 shrink-0"></div>

                <!-- List Pasien -->
                <div class="flex-1 flex flex-col min-h-[200px] mt-4">
                    <div class="flex items-center gap-2 text-indigo-900 font-bold mb-1 text-sm shrink-0">
                        <i class="ph ph-address-book text-lg"></i> ATAU PILIH PASIEN TERDAFTAR
                    </div>
                    <p class="text-[10px] text-slate-400 mb-4 shrink-0">Pilih profil dari riwayat sesi ini</p>
                    <div class="space-y-3 flex-1 overflow-y-auto custom-scrollbar pr-2 pb-4" id="patient-list-container">
                        <!-- List dinamis di-generate via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- ========================================== -->
    <!-- VIEW: MAIN DASHBOARD -->
    <!-- ========================================== -->
    <div id="view-dashboard" class="hidden h-full w-full overflow-hidden bg-slate-50 relative">
        
        <!-- --- BACKGROUND MOTIF & WATERMARK --- -->
        <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden bg-gradient-to-br from-slate-50 to-blue-50/30">
            <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(#3b82f6 1px, transparent 1px); background-size: 24px 24px;"></div>
            <i class="ph-fill ph-heartbeat absolute -top-10 -left-10 text-[300px] text-blue-500 opacity-[0.03] -rotate-12"></i>
            <i class="ph-fill ph-first-aid absolute top-1/3 -right-20 text-[250px] text-indigo-500 opacity-[0.03] rotate-12"></i>
            <i class="ph-fill ph-dna absolute -bottom-20 left-1/4 text-[400px] text-emerald-500 opacity-[0.03] -rotate-45"></i>
            <i class="ph-fill ph-stethoscope absolute bottom-10 right-1/4 text-[200px] text-red-500 opacity-[0.03] rotate-45"></i>
            <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 flex flex-col items-center opacity-[0.03] animate-pulse" style="animation-duration: 4s;">
                <i class="ph-fill ph-heartbeat text-[150px] text-slate-800"></i>
                <h1 class="text-7xl font-black tracking-tighter text-slate-900 mt-2">MEDISYNE</h1>
            </div>
        </div>

        <!-- --- KONTEN UTAMA --- -->
        <main class="w-full max-w-7xl mx-auto p-3 sm:p-6 lg:p-8 h-full overflow-y-auto flex flex-col gap-4 sm:gap-6 relative z-10 custom-scrollbar">
            
            <!-- Header Pasien Aktif -->
            <header class="bg-[#1e293b] rounded-3xl p-5 flex flex-wrap items-center justify-between text-white shadow-xl gap-4 shrink-0">
                <div class="flex items-center gap-5">
                    <button onclick="keluarDashboard()" class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition shrink-0 cursor-pointer text-white hover:text-red-400 group">
                        <i class="ph-bold ph-sign-out text-xl group-hover:-translate-x-1 transition-transform"></i>
                    </button>
                    <div class="flex items-center gap-4">
                        <div id="header-avatar" class="w-16 h-16 rounded-full bg-slate-600 text-white flex items-center justify-center text-3xl shadow-lg border-2 border-slate-500">
                            ❓
                        </div>
                        <div>
                            <p class="text-xs font-bold text-[#38bdf8] tracking-widest uppercase mb-1" id="header-role-label">Belum Ada Pasien</p>
                            <h2 id="header-name" class="text-2xl font-black truncate max-w-[150px] sm:max-w-xs text-white">Pilih Profil</h2>
                        </div>
                    </div>
                </div>

                <div class="flex gap-6 sm:gap-10 mt-2 sm:mt-0 flex-wrap mr-4">
                    <div>
                        <p class="text-[10px] text-slate-400 flex items-center gap-1 mb-1 font-bold tracking-wider"><i class="ph ph-user"></i> USIA</p>
                        <p id="header-age" class="font-bold text-lg text-white">-</p>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-400 flex items-center gap-1 mb-1 font-bold tracking-wider"><i class="ph ph-activity"></i> KLASIFIKASI</p>
                        <p id="header-classification" class="font-bold text-lg text-emerald-400 uppercase">-</p>
                    </div>
                    <div class="hidden sm:block">
                        <p class="text-[10px] text-slate-400 flex items-center gap-1 mb-1 font-bold tracking-wider"><i class="ph ph-calendar-blank"></i> TANGGAL</p>
                        <p id="header-date" class="font-bold text-lg text-white">--/--/----</p>
                    </div>
                </div>
            </header>

            <!-- DOCTOR: PATIENT SELECTOR (Hidden by default) -->
            <div id="doctor-patient-selector" class="hidden bg-white rounded-2xl p-5 shadow-sm border border-emerald-100 shrink-0">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-slate-700 flex items-center gap-2 text-sm"><i class="ph-fill ph-users text-emerald-500 text-lg"></i> Daftar Pasien Terdaftar</h3>
                    <span id="doc-badge-name" class="text-[10px] font-black bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full uppercase tracking-wider">Dr. Anonim</span>
                </div>
                <div id="doc-patient-list" class="flex gap-4 overflow-x-auto pb-2 custom-scrollbar">
                    <!-- List pasien khusus dokter akan di-generate via JS -->
                </div>
            </div>

            <!-- Banner Sensor Status -->
            <div id="status-banner" class="bg-white rounded-2xl p-5 flex flex-col md:flex-row items-center justify-between border border-red-200 shadow-sm gap-4 transition-colors shrink-0">
                <div class="flex items-start gap-4">
                    <div id="status-icon-bg" class="bg-red-50 p-4 rounded-2xl text-red-500 shrink-0">
                        <i class="ph-fill ph-hand text-3xl"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <h3 class="font-black text-slate-700 text-base sm:text-lg tracking-tight">KONEKSI SENSOR MEDIS</h3>
                            <span id="status-badge" class="px-2 py-1 rounded text-[10px] font-bold text-white bg-red-500 transition-colors tracking-wider">OFFLINE</span>
                        </div>
                        <p class="text-sm text-slate-500 max-w-2xl leading-relaxed font-medium">
                            <span id="status-text">Pasien belum menyentuh elektroda sensor. Tekan tombol di sebelah kanan untuk menyalakan sinkronisasi data real-time.</span>
                        </p>
                    </div>
                </div>
                <button id="status-button" onclick="toggleSensor()" class="bg-[#4f46e5] hover:bg-indigo-700 text-white font-bold text-sm py-4 px-8 rounded-xl flex items-center gap-3 whitespace-nowrap shadow-xl shadow-indigo-500/30 transition-all w-full md:w-auto justify-center active:scale-95 transform duration-150 cursor-pointer">
                    <i class="ph-bold ph-power text-xl"></i> <span id="status-button-text">NYALAKAN SENSOR</span>
                </button>
            </div>

            <!-- Title Parameter -->
            <div id="param-title" class="flex items-center gap-2 text-slate-700 font-bold mt-2 shrink-0">
                <i class="ph-fill ph-heart text-red-500 text-xl animate-pulse"></i>
