        function pilihPasienOlehDokter(id) {
            const selectedProfile = registeredPatients.find(p => p.id === id);
            if(selectedProfile) {
                setPasienAktif(selectedProfile);
                renderDoctorPatientList(); // Refresh active state
                showToast(`Memantau profil ${selectedProfile.name}`, 'success');
            }
        }

        // --- FITUR CHAT & RESEP ---
        function handleChatKey(e) {
            if (e.key === 'Enter') sendChat();
        }

        async function fetchChat() {
            if (!currentProfile || isMockMode) return;
            try {
                const response = await fetch(`${DB_URL}/chats/${currentProfile.id}.json?auth=${SECRET_KEY}`);
                if (!response.ok) return;
                const data = await response.json();
                
                if (data) {
                    const messagesArray = Object.values(data);
                    // Update hanya jika ada pesan baru agar scroll tidak patah-patah
                    if (!chatData[currentProfile.id] || chatData[currentProfile.id].length !== messagesArray.length) {
                        chatData[currentProfile.id] = messagesArray;
                        renderChat();
                    }
                }
            } catch (e) {
                console.error("Gagal sinkronisasi chat:", e);
            }
        }

        async function sendChat() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            if (!currentProfile) {
                showToast("Pilih pasien terlebih dahulu!", "warning");
                return;
            }

            const newMessage = {
                sender: activeDoctor ? 'doctor' : 'patient',
                text: text,
                time: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })
            };

            if (!chatData[currentProfile.id]) chatData[currentProfile.id] = [];
            
            chatData[currentProfile.id].push(newMessage);
            
            input.value = '';
            renderChat();

            try {
                await fetch(`${DB_URL}/chats/${currentProfile.id}.json?auth=${SECRET_KEY}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(newMessage)
                });
            } catch (e) {
                console.error("Gagal mengirim pesan:", e);
                showToast("Gagal mengirim ke server.", "error");
            }
        }

        function renderChat() {
            const container = document.getElementById('chat-messages');
            
            if (!currentProfile) {
                container.innerHTML = `<div class="flex-1 flex items-center justify-center text-xs text-slate-400">Pilih pasien untuk memulai percakapan.</div>`;
                return;
            }

            const msgs = chatData[currentProfile.id] || [];
            
            if (msgs.length === 0) {
                container.innerHTML = `
                    <div class="flex-1 flex flex-col items-center justify-center text-center opacity-60">
                        <i class="ph-fill ph-chat-circle-dots text-4xl text-slate-300 mb-2"></i>
                        <p class="text-xs text-slate-500">Belum ada percakapan atau resep.</p>
                        <p class="text-[10px] text-slate-400 mt-1">Kirim pesan pertama sekarang.</p>
                    </div>`;
                return;
            }

            container.innerHTML = msgs.map(m => {
                const isDoctor = m.sender === 'doctor';
                // IsMe: Apakah pesan ini dikirim oleh user yang sedang login?
                const isMe = (activeDoctor && isDoctor) || (!activeDoctor && !isDoctor);
                
                const bubbleColor = isMe 
                    ? (isDoctor ? 'bg-emerald-500 text-white rounded-tr-sm' : 'bg-blue-500 text-white rounded-tr-sm')
                    : 'bg-white border border-slate-200 text-slate-700 rounded-tl-sm';
                    
                const alignClass = isMe ? 'items-end' : 'items-start';
                const labelText = isDoctor ? 'Dokter' : 'Pasien';

                return `
                <div class="flex flex-col ${alignClass} w-full animate-[slideIn_0.2s_ease-out]">
                    <div class="max-w-[85%] rounded-2xl p-3 text-sm shadow-sm ${bubbleColor}">
                        ${m.text}
                    </div>
                    <span class="text-[9px] text-slate-400 mt-1 font-semibold mx-1">${m.time} • ${labelText}</span>
                </div>
                `;
            }).join('');
            
            // Auto scroll ke bawah
            container.scrollTop = container.scrollHeight;
        }

        // --- PENDAFTARAN PASIEN ---
        function simpanPasienBaru() {
            const nama = document.getElementById('input-new-name').value.trim();
            const umur = parseInt(document.getElementById('input-new-age').value);

            if (!nama || isNaN(umur) || umur <= 0) {
                showToast("Nama dan umur valid wajib diisi!", "error");
                return;
            }

            const newProfile = { id: Date.now(), name: nama, age: umur, emoji: selectedAvatarEmoji };
            registeredPatients.push(newProfile);
            setPasienAktif(newProfile);
            showToast("Pasien berhasil didaftarkan!", "success");

            document.getElementById('input-new-name').value = '';
            document.getElementById('input-new-age').value = '';
            
            switchView('dashboard');
            if (!isOnlineState) toggleSensor();
        }

        // --- DAFTAR PASIEN & PROFIL UI ---
        function renderPatientList() {
            const container = document.getElementById('patient-list-container');
            if (registeredPatients.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-6 border-2 border-dashed border-slate-200 rounded-2xl font-medium">Belum ada pasien terdaftar.</p>`;
