        // --- POLLING DATA ---
        async function fetchData(isInitial = false) {
            if (isMockMode) {
                handleDataSuccess(generateMockData(), isInitial);
                return;
            }

            try {
                const response = await fetch(`${DB_URL}/patients/patient_001/latest.json?auth=${SECRET_KEY}`);
                if (!response.ok) throw new Error('Network fail');
                const data = await response.json();
                handleDataSuccess(data, isInitial);
            } catch (error) {
                console.warn("Firebase gagal. Beralih ke Mock Mode (Simulasi).");
                isMockMode = true;
                handleDataSuccess(generateMockData(), isInitial);
            }
        }

        function handleDataSuccess(data, isInitial) {
            if (data) {
                if (!isInitial) setOnlineStatus(true);
                prevLatestDataStr = JSON.stringify(data);
                if (!isInitial || isOnlineState) updateCardsUI(data);
            } else {
                if (!isInitial) setOnlineStatus(false);
            }
        }

        function generateMockData() {
            return {
                bodyTemperature: (36.5 + (Math.random() * 2 - 0.5)).toFixed(1),
                heartRate: Math.floor(75 + (Math.random() * 30 - 15)),
                spo2: Math.floor(96 + (Math.random() * 5 - 2)),
                roomTemperature: (23.0 + (Math.random() * 6 - 2)).toFixed(1),
                humidity: Math.floor(50 + (Math.random() * 20 - 10)),
                airQuality: Math.floor(150 + (Math.random() * 900 - 100))
            };
        }

        // --- LOGIKA PEWARNAAN KARTU (TEMA DINAMIS & ANIMASI POP) ---
        function setCardTheme(cardId, theme, textStatus, value) {
            const card = document.getElementById(cardId);
            const valEl = document.getElementById(`val-${cardId.split('-')[1]}`);
            const textEl = document.getElementById(`status-${cardId.split('-')[1]}-text`);
            const iconEl = document.getElementById(`icon-${cardId.split('-')[1]}`);

            card.style.opacity = '1';
            card.style.animation = "none"; // Reset any specific animations
            card.className = "card-metric transition-all duration-500 ease-in-out p-6 rounded-3xl border-2 flex flex-col justify-between h-44 relative overflow-hidden group";
            
            if (value !== 0 && value !== '---' && isOnlineState) {
                valEl.classList.remove('value-update');
                void valEl.offsetWidth; 
                valEl.classList.add('value-update');
            }

            if (theme === 'offline') {
                card.classList.add('bg-slate-100', 'border-slate-200');
                valEl.className = "text-5xl font-black text-slate-400 tracking-tighter";
                textEl.className = "text-[10px] font-black tracking-wider text-slate-400 bg-black/5 px-2 py-1 rounded-md";
                iconEl.className = `${iconEl.className.split(' ')[0]} ${iconEl.className.split(' ')[1]} text-3xl text-slate-400`;
                valEl.innerText = '0';
                textEl.innerText = textStatus;
                return;
            }

            valEl.innerText = value;
            textEl.innerText = textStatus;

            if (theme === 'optimal') {
                card.classList.add('bg-gradient-to-br', 'from-emerald-50', 'to-emerald-100', 'border-emerald-300', 'shadow-[0_4px_20px_rgba(16,185,129,0.15)]');
                valEl.className = "text-5xl font-black text-emerald-700 tracking-tighter";
                textEl.className = "text-[10px] font-black tracking-wider text-emerald-700 bg-emerald-200/50 px-2 py-1 rounded-md";
                iconEl.className = `${iconEl.className.split(' ')[0]} ${iconEl.className.split(' ')[1]} text-3xl text-emerald-500`;
            } else if (theme === 'warning') {
                card.classList.add('bg-gradient-to-br', 'from-yellow-50', 'to-yellow-100', 'border-yellow-300', 'shadow-[0_4px_20px_rgba(245,158,11,0.15)]');
                valEl.className = "text-5xl font-black text-yellow-700 tracking-tighter";
                textEl.className = "text-[10px] font-black tracking-wider text-yellow-700 bg-yellow-200/50 px-2 py-1 rounded-md";
                iconEl.className = `${iconEl.className.split(' ')[0]} ${iconEl.className.split(' ')[1]} text-3xl text-yellow-500`;
            } else if (theme === 'danger') {
                card.classList.add('bg-gradient-to-br', 'from-red-50', 'to-red-100', 'border-red-400');
                card.style.animation = "pulseAlert 2s infinite"; 
                valEl.className = "text-5xl font-black text-red-700 tracking-tighter";
                textEl.className = "text-[10px] font-black tracking-wider text-white bg-red-500 px-2 py-1 rounded-md animate-pulse";
                iconEl.className = `${iconEl.className.split(' ')[0]} ${iconEl.className.split(' ')[1]} text-3xl text-red-500`;
            } else if (theme === 'info') {
                card.classList.add('bg-gradient-to-br', 'from-blue-50', 'to-blue-100', 'border-blue-300', 'shadow-[0_4px_20px_rgba(59,130,246,0.15)]');
                valEl.className = "text-5xl font-black text-blue-700 tracking-tighter";
                textEl.className = "text-[10px] font-black tracking-wider text-blue-700 bg-blue-200/50 px-2 py-1 rounded-md";
                iconEl.className = `${iconEl.className.split(' ')[0]} ${iconEl.className.split(' ')[1]} text-3xl text-blue-500`;
            }
        }

        // --- UPDATE LOGIC KARTU ---
        function updateCardsUI(latest) {
            updateTemperatureLogic(latest.bodyTemperature);
            updateHeartRateLogic(latest.heartRate);
            updateSpo2Logic(latest.spo2);
            updateRoomTempLogic(latest.roomTemperature);
            updateHumidityLogic(latest.humidity);
            updateAirQualityLogic(latest.airQuality);
        }

        function updateTemperatureLogic(val) {
            const temp = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (temp === 0) {
                setCardTheme('card-temp', 'offline', 'TIDAK TERDETEKSI', 0);
                lastFeverAlertTime = 0;
            } else if (temp >= 38.0) {
                setCardTheme('card-temp', 'danger', 'DEMAM TINGGI', temp);
                const now = Date.now();
                if (now - lastFeverAlertTime > 15000) {
                    showToast(`Suhu Tubuh Tinggi! Terdeteksi indikasi demam (${temp}°C)`, 'error');
                    lastFeverAlertTime = now;
                }
            } else if (temp >= 36.1 && temp <= 37.2) {
                setCardTheme('card-temp', 'optimal', 'SUHU OPTIMAL', temp);
            } else {
                setCardTheme('card-temp', 'warning', 'SUB-OPTIMAL', temp);
            }
        }

        function updateHeartRateLogic(val) {
            const bpm = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (bpm === 0) setCardTheme('card-bpm', 'offline', 'MENUNGGU SENSOR', 0);
            else if (bpm < 60) setCardTheme('card-bpm', 'info', 'DETAK RENDAH', bpm);
            else if (bpm >= 60 && bpm <= 100) setCardTheme('card-bpm', 'optimal', 'DETAK NORMAL', bpm);
            else setCardTheme('card-bpm', 'danger', 'DETAK TINGGI!', bpm);
        }

        function updateSpo2Logic(val) {
            const spo2 = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (spo2 === 0) setCardTheme('card-spo2', 'offline', 'MENUNGGU SENSOR', 0);
            else if (spo2 >= 95) setCardTheme('card-spo2', 'optimal', 'OKSIGEN NORMAL', spo2);
            else if (spo2 >= 91 && spo2 <= 94) setCardTheme('card-spo2', 'warning', 'OKSIGEN RENDAH', spo2);
            else setCardTheme('card-spo2', 'danger', 'HIPOKSIA BAHAYA!', spo2);
        }

        function updateRoomTempLogic(val) {
            const temp = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (temp === 0) setCardTheme('card-roomtemp', 'offline', 'MENUNGGU SENSOR', 0);
            else if (temp >= 28.0) setCardTheme('card-roomtemp', 'danger', 'RUANGAN PANAS', temp);
            else if (temp >= 24.0 && temp < 28.0) setCardTheme('card-roomtemp', 'warning', 'RUANGAN HANGAT', temp);
            else if (temp >= 18.0 && temp <= 22.0) setCardTheme('card-roomtemp', 'info', 'RUANGAN DINGIN', temp);
            else setCardTheme('card-roomtemp', 'optimal', 'SEJUK OPTIMAL', temp);
        }

        function updateHumidityLogic(val) {
            const hum = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (hum === 0) setCardTheme('card-humidity', 'offline', 'MENUNGGU SENSOR', 0);
            else if (hum >= 40 && hum <= 60) setCardTheme('card-humidity', 'optimal', 'KELEMBAPAN BAIK', hum);
            else if (hum < 40) setCardTheme('card-humidity', 'warning', 'UDARA KERING', hum);
            else setCardTheme('card-humidity', 'info', 'TERLALU LEMBAP', hum);
        }

        function updateAirQualityLogic(val) {
            const aqi = (val === undefined || val === null || val === "") ? 0 : parseFloat(val);
            if (aqi === 0) setCardTheme('card-aqi', 'offline', 'MENUNGGU SENSOR', 0);
            else if (aqi >= 1001) setCardTheme('card-aqi', 'danger', 'UDARA BURUK!', aqi);
            else if (aqi >= 401 && aqi <= 1000) setCardTheme('card-aqi', 'warning', 'KUALITAS SEDANG', aqi);
            else if (aqi >= 51 && aqi <= 400) setCardTheme('card-aqi', 'optimal', 'UDARA BAIK', aqi);
            else setCardTheme('card-aqi', 'info', 'SANGAT BERSIH', aqi);
        }

        // --- STATUS SENSOR KONEKSI ---
        function setOnlineStatus(isOnline) {
            if (isOnline === isOnlineState) return; 
            isOnlineState = isOnline;

            const banner = document.getElementById('status-banner');
            const badge = document.getElementById('status-badge');
            const iconBg = document.getElementById('status-icon-bg');
            const text = document.getElementById('status-text');
            const button = document.getElementById('status-button');

            if (isOnline) {
                banner.className = "bg-emerald-50/50 rounded-2xl p-5 flex flex-col md:flex-row items-center justify-between border-2 border-emerald-400 shadow-lg shadow-emerald-500/10 gap-4 transition-all duration-500 shrink-0";
                iconBg.className = "bg-emerald-500 p-4 rounded-2xl text-white shadow-lg shadow-emerald-500/40 shrink-0 animate-pulse";
                badge.className = "px-2 py-1 rounded text-[10px] font-black text-emerald-800 bg-emerald-200 tracking-wider";
                badge.innerText = 'ONLINE REAL-TIME';
                text.innerHTML = "<strong class='text-emerald-700'>Sinkronisasi Aktif.</strong> Membaca data metrik dari sensor setiap 1 detik.";
                button.innerHTML = `<i class="ph-bold ph-stop text-xl"></i> <span id="status-button-text">HENTIKAN SENSOR</span>`;
                button.className = "bg-red-500 hover:bg-red-600 text-white font-bold text-sm py-4 px-8 rounded-xl flex items-center gap-3 whitespace-nowrap shadow-xl shadow-red-500/30 transition-all w-full md:w-auto justify-center active:scale-95 transform duration-150 cursor-pointer";
            } else {
                banner.className = "bg-white rounded-2xl p-5 flex flex-col md:flex-row items-center justify-between border-2 border-slate-200 shadow-sm gap-4 transition-all duration-500 shrink-0";
                iconBg.className = "bg-slate-100 p-4 rounded-2xl text-slate-400 shrink-0";
                badge.className = "px-2 py-1 rounded text-[10px] font-black text-slate-500 bg-slate-200 tracking-wider";
                badge.innerText = 'OFFLINE';
                text.innerText = "Pasien belum menyentuh elektroda sensor. Tekan tombol di sebelah kanan untuk menyalakan sinkronisasi data real-time.";
                button.innerHTML = `<i class="ph-bold ph-power text-xl"></i> <span id="status-button-text">NYALAKAN SENSOR</span>`;
                button.className = "bg-[#4f46e5] hover:bg-indigo-700 text-white font-bold text-sm py-4 px-8 rounded-xl flex items-center gap-3 whitespace-nowrap shadow-xl shadow-indigo-500/30 transition-all w-full md:w-auto justify-center active:scale-95 transform duration-150 cursor-pointer";
                
                updateCardsUI({ bodyTemperature: 0, heartRate: 0, spo2: 0, roomTemperature: 0, humidity: 0, airQuality: 0 });
            }
        }

        function toggleSensor() {
            if (!isOnlineState) {
                setOnlineStatus(true);
                fetchData(); 
                pollingInterval = setInterval(fetchData, 1000); 
                showToast("Sensor dinyalakan, memulai pembacaan...", "success");
            } else {
                if (prevLatestDataStr) {
                    addHistory(JSON.parse(prevLatestDataStr));
                    prevLatestDataStr = null;
                }
                setOnlineStatus(false);
                if (typeof pollingInterval !== 'undefined' && pollingInterval) { 
                    clearInterval(pollingInterval); 
                    pollingInterval = null; 
                }
            }
        }

        // --- HISTORI & FILTERING PASIEN AKTIF ---
        function addHistory(oldData) {
            if (!oldData || (oldData.heartRate === 0 && oldData.bodyTemperature === 0)) return;
            const namaLog = currentProfile ? currentProfile.name : 'Anonim';
            const newItem = { timestamp: new Date(), data: oldData, patientName: namaLog };
            
            historyArray.unshift(newItem); 
            if (historyArray.length > 100) historyArray.pop(); 
            
            renderHistoryTable();
            showToast("Log sensor disimpan ke riwayat cloud.", "success");
        }

        function renderHistoryTable() {
            const emptyState = document.getElementById('history-empty');
            const tableContainer = document.getElementById('history-table-container');
            const tbody = document.getElementById('history-tbody');
            
            if (!currentProfile) {
                emptyState.classList.remove('hidden');
                tableContainer.classList.add('hidden');
                return;
            }
            
            const activePatientName = currentProfile.name;
            const filteredHistory = historyArray.filter(item => item.patientName === activePatientName);

            if (filteredHistory.length === 0) {
                emptyState.classList.remove('hidden');
                tableContainer.classList.add('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            tableContainer.classList.remove('hidden');

            tbody.innerHTML = filteredHistory.map(item => `
                <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors text-xs text-slate-700 font-medium">
                    <td class="py-3 px-4 whitespace-nowrap">
                        ${item.timestamp.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second:'2-digit' })}
                    </td>
                    <td class="py-3 px-3 text-center">${item.data.heartRate || '-'}</td>
                    <td class="py-3 px-3 text-center">${item.data.bodyTemperature || '-'}°C</td>
                    <td class="py-3 px-3 text-center">${item.data.spo2 || '-'}%</td>
                    <td class="py-3 px-3 text-center">${item.data.roomTemperature || '-'}°C</td>
                    <td class="py-3 px-3 text-center">${item.data.humidity || '-'}%</td>
                    <td class="py-3 px-3 text-center font-bold">${item.data.airQuality || '-'}</td>
                </tr>
            `).join('');
        }

        // --- HELPER UMUR ---
        function getClassification(age) {
            if (age === 0 || !age) return '-';
            if (age < 12) return 'ANAK-ANAK';
            if (age < 19) return 'REMAJA';
            if (age < 60) return 'DEWASA';
            return 'LANSIA';
        }

        // --- SLIDESHOW ---
        function initSlider() { startSlideShow(); }
        function moveSlide(dir) {
            currentSlide = (currentSlide + dir + totalSlides) % totalSlides;
            updateSliderUI();
            resetSlideInterval();
        }
        function goToSlide(index) {
            currentSlide = index;
            updateSliderUI();
            resetSlideInterval();
        }
        function updateSliderUI() {
            const slider = document.getElementById('health-slider');
            if(slider) slider.style.transform = `translateX(-${currentSlide * 100}%)`;
            
            document.querySelectorAll('.slide-dot').forEach((dot, index) => {
                dot.className = index === currentSlide 
                    ? 'slide-dot w-5 h-2 rounded-full bg-blue-600 transition-all duration-300' 
                    : 'slide-dot w-2 h-2 rounded-full bg-blue-300 hover:bg-blue-500 transition-all duration-300';
            });
        }
        function startSlideShow() { slideInterval = setInterval(() => { moveSlide(1); }, 5000); }
        function resetSlideInterval() { clearInterval(slideInterval); startSlideShow(); }

    </script>
</body>
</html>
