        // --- DAFTAR PASIEN KHUSUS DOKTER ---
        function renderDoctorPatientList() {
            const container = document.getElementById('doc-patient-list');
            if (registeredPatients.length === 0) {
                container.innerHTML = `<div class="text-xs text-slate-400 italic">Belum ada pasien yang mendaftar di sistem.</div>`;
                return;
            }

            container.innerHTML = [...registeredPatients].reverse().map(p => {
                const isActive = currentProfile && currentProfile.id === p.id;
                const bgColor = getAvatarColorClass(p.emoji);
                return `
                <button onclick="pilihPasienOlehDokter(${p.id})" class="flex items-center gap-3 p-3 rounded-2xl border ${isActive ? 'border-emerald-500 bg-emerald-50' : 'border-slate-200 bg-white hover:border-emerald-300'} transition-all min-w-[200px] text-left shadow-sm shrink-0">
