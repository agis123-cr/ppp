                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full ${bgColor} text-white flex items-center justify-center text-2xl shadow-md border-2 border-white">
                            ${p.emoji}
                        </div>
                        <div>
                            <p class="text-base font-black text-slate-700">${p.name}</p>
                            <p class="text-[11px] text-slate-500 font-bold">${p.age} THN • ${klasifikasi}</p>
